# panvk vulkan hwui & renderengine config
# HWUI 渲染器使用稳定的 skiagl (GL)，避免系统级 UI 因 panvk 尚不完善的 HardwareBitmap upload 产生渲染花屏或崩溃
# 游戏、模拟器和 Vulkan 独立应用仍直接调用 PanVK (Vulkan 1.4)
debug.hwui.renderer=skiagl

# SurfaceFlinger 桌面图层合成使用 GL (利用 Mali 原生 blob 硬件解码 AFBC 图层，避免合成崩溃)
debug.renderengine.backend=skiagl
debug.renderengine.vulkan=false

# Mesa 与 PanVK 调试日志
debug.mesa.log.level=debug
debug.mesa.vk.log=1

# kbase DVFS 保持 MTK 出厂默认
debug.mesa.panvk.kbase.dvfs=none
